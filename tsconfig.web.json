{
    "compilerOptions": {
        "composite": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "jsx": "preserve",
        "baseUrl": ".",
        "paths": {
            "@fairy/*": ["src/engine/*"],
            "@fairy-core/*": ["src/core/*"],
            "@runtime/*": ["src/runtime/*"],
            "@renderer/*": ["src/renderer/src/*"],
            "@project/*": ["src/project/*"],
            "@blocks/*": ["src/blocks/*"]
        }
    },
    "include": [
        "src/renderer/src/**/*",
        "src/renderer/src/**/*.vue",
        "src/preload/*.d.ts",
        "src/engine/**/*",
        "src/core/**/*",
        "src/runtime/**/*",
        "src/project/**/*",
        "src/blocks/**/*",
        "tests/**/*"
    ]
}
